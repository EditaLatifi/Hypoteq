# Database URLs for Vercel + Supabase
# For local development, you can use DATABASE_URL
DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?sslmode=require"

# For Vercel production (required for serverless functions)
# Connection pooling URL (port 6543)
POSTGRES_PRISMA_URL="postgresql://postgres:password@db.xxx.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection URL (port 5432) - used for migrations
POSTGRES_URL_NON_POOLING="postgresql://postgres:[YOUR-PASSWORD]@db.xxx.supabase.co:5432/postgres?sslmode=require"
# Other environment variables
# Add your other env vars here

# Salesforce — OAuth 2.0 Client Credentials Flow (connected app), see components/salesforceApi.ts.
# The connected app's "run as" user MUST have the Person Account record type assigned to its
# profile or a permission set; without it every Account (and therefore every Case) write fails.
SF_CLIENT_ID=your-connected-app-consumer-key
SF_CLIENT_SECRET=your-connected-app-consumer-secret
# No trailing slash — the token URL is built as `${SF_LOGIN_URL}/services/oauth2/token`.
SF_LOGIN_URL=https://your-org.my.salesforce.com

# Sales Partner (Account lookup on Case, label "Sales Partner"). Direct-customer leads
# are attributed to HYPOTEQ AG itself. Note the API name is `Account__c`, which is NOT
# the standard `AccountId` field — that one holds the customer.
SF_SALES_PARTNER_FIELD=Account__c
HYPOTEQ_ACCOUNT_NAME=HYPOTEQ AG

# Partner recognition (Funnel v3, DECISIONS D13): which Contacts count as an active
# VP-Berater. A SOQL boolean fragment appended to
#   SELECT ... FROM Contact WHERE Email = '<email>' <filter> ORDER BY CreatedDate ASC LIMIT 1
# e.g. AND Account.Type = 'Vertriebspartner'   (a leading AND is added if missing).
# Empty = any Contact with that exact e-mail is a partner. Server-side only; never put user
# input here. @hypoteq.ch addresses (the only HYPOTEQ domain, HYPOTEQ 19.10. A.2) are matched
# against active Users instead. Live lookup; when Salesforce is unreachable the last successful
# answer for the address (in memory, per instance, at most 24 h old) is used (B17).
SF_PARTNER_CONTACT_FILTER=

# Juristische Person → Business Account + Contact (HYPOTEQ 19.10. B16, docs/funnel-v5/DECISIONS
# V63): the Account field that holds the UID (CHE-123.456.789). Unset uses UID__c; an org
# without the field looks the company up by Name only. Plain API name only (it goes into SOQL).
# SF_ACCOUNT_UID_FIELD=UID__c

# Owner of a funnel Case (HYPOTEQ 19.10. D.2, DECISIONS V64): the Case queue looked up by Name or
# DeveloperName. A HYPOTEQ user as Berater owns the Case instead. Not found → default owner.
# SF_FUNNEL_QUEUE_NAME=Web-Anfragen
# SF_FUNNEL_QUEUE_DEVELOPER_NAME=Web_Anfragen

# OpenAI — AI Document Intelligence (Klassifikation + Extraktion hochgeladener Dokumente).
# Server-side only: never expose this under a NEXT_PUBLIC_ name — that ships the key to
# every visitor's browser. Read it in route handlers / server modules, as the Salesforce
# credentials above are.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which model reads the documents. Unset uses gpt-5.5. Configurable so accuracy and cost can
# be retuned without a deploy — a cheaper model is a reasonable trade on clean PDFs and a
# poor one on phone photos of a scan.
OPENAI_DOCUMENT_MODEL=

# How long one analysis may take before it is abandoned, in ms. Unset uses 45000. Measured:
# a recognisable document answers in 5-7s, so this is a ceiling for the pathological case,
# not a normal wait. It must stay BELOW the function's own limit (60s on Hobby, set in
# vercel.json): a timeout we raise ourselves becomes a document the customer can classify by
# hand, while one the platform raises is a dead request with no answer in it.
DOCAI_TIMEOUT_MS=

# Confidence thresholds (spec section 15). Unset uses 0.90 / 0.70. The spec calls these
# initial guesses to be tuned during testing, which is why they are not in the code.
DOCAI_CONFIDENCE_ACCEPT=
DOCAI_CONFIDENCE_REVIEW=

# Document Intelligence runs on Preview and locally. In the Production scope it stays off
# unless this is explicitly set — going live is a decision someone makes on purpose, not a
# state reached by adding OPENAI_API_KEY to the wrong scope. Leave UNSET in Production until
# the feature is signed off.
HYPOTEQ_DOCAI_IN_PRODUCTION=

# Funnel v3 internal view (confidence percentages, audit trail, rename) opens with
# ?intern=<this value> on the documents step. UNSET → "1" (DECISIONS D23). Build-time public
# variable: it gates a view, never data.
NEXT_PUBLIC_V3_INTERN_KEY=

# Test deployments only. UNSET means production — a live deployment that lost this variable
# must behave as production and be caught by a missing Salesforce Case, never quietly
# swallow real leads. Set to 1 ONLY in Vercel's Preview scope, never in Production.
# When on: no Salesforce Case, no mail, SharePoint folders prefixed ZZ-TEST_. The database
# is still written, because a submission that skips it proves nothing.
HYPOTEQ_TEST_MODE=

# Partnerportal (/portal). Tables: run prisma/partner-portal.sql once.
# HYPOTEQ admins: they log in by magic link without an invite and manage partner access.
PORTAL_ADMIN_EMAILS=admin1@hypoteq.ch,admin2@hypoteq.ch
# Links in invite / reset / magic-link mails go back to the host the request came in on when
# it is one of ours (this deployment's Vercel URLs, PORTAL_BASE_URL, NEXT_PUBLIC_SITE_URL,
# PORTAL_TRUSTED_HOSTS); otherwise, and for the cron, to PORTAL_BASE_URL, else this
# deployment's own domain. Point PORTAL_BASE_URL only at a deployment that serves /portal —
# production (main) does not yet. Leave it unset on previews.
# PORTAL_BASE_URL=
# Further hosts the portal is reached on (custom domains), comma-separated.
# PORTAL_TRUSTED_HOSTS=
# Mailbox the portal e-mails are sent from (Graph). Defaults to SMTP_USER.
# PORTAL_MAIL_FROM=portal@hypoteq.ch
# Where the profile reads the IBAN and the partner number (Contact fields or Account.<Field>).
# PORTAL_SF_IBAN_FIELDS=Account.IBAN_Nr__c
# PORTAL_SF_PARTNER_NR_FIELDS=Account.AccountNumber
# Case field that points at the partner's Contact. Default: Partner_Consultant__c
# PORTAL_SF_PARTNER_FIELD=Partner_Consultant__c
# Portal status field on Case (set by HYPOTEQ's flows, 11 values): read whenever the org has
# it (checked by describe); empty on a Case = the derived status. Default Portal_Status__c;
# "off" ignores it.
# PORTAL_SF_STATUS_FIELD=Portal_Status__c
# Case checkbox the status flow ticks while documents are missing; drives «Aktion erforderlich».
# Default Partner_Action_Required__c; "off" ignores it.
# PORTAL_SF_ACTION_FIELD=Partner_Action_Required__c
# Partner control on the partner's Account (Portal_Access__c, Portal_Visible__c): shown on the
# admin partner page, enforced only with "on" (an unticked access box then refuses the login,
# an unticked visibility box hides the partner's Cases). Default off: a new checkbox is false
# for every partner until HYPOTEQ ticks it.
# PORTAL_ENFORCE_ACCOUNT_FLAGS=off
# The portal's own e-mails to partners about Case changes: "on" sends them (never to a
# company whose Account.Send_Notification__c is unticked). Default off — HYPOTEQ's Salesforce
# flows will send these mails once the texts are released; the in-portal Meldungen stay.
# PORTAL_STATUS_MAILS=off
# Where partner messages and support reports go (the Case page names this address).
# Default info@hypoteq.ch, HYPOTEQ's only address; override only for a test deployment.
# PORTAL_TEAM_EMAIL=info@hypoteq.ch
# Spezialfinanzierung: Case record type and owner queue (Name or DeveloperName, resolved at
# runtime); "off" for no queue. PORTAL_SF_SPECIAL_OWNER_ID (an Id) wins over the queue.
# PORTAL_SF_SPECIAL_RECORD_TYPE=Spezialfinanzierung
# PORTAL_SF_SPECIAL_QUEUE=Spezialfinanzierung
# Owner of the Salesforce Task each support report opens (default: Fisnik Salihu).
# PORTAL_SUPPORT_TASK_OWNER_ID=005TG000004Ogi9YAC
# Optional: extra Stage__c -> portal status mappings (see lib/portal/status.ts).
# PORTAL_STAGE_MAP={"Dokumente prüfen":"In Prüfung","Bank angefragt":"Bei Kreditgeber"}
