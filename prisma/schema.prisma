// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}
model Inquiry {
  id           String     @id @default(uuid())
  customerType String
  createdAt    DateTime   @default(now())

  // Salesforce sync outcome. The sync is non-fatal for the customer, so without this
  // an outage is invisible: "which leads never reached Salesforce" must be a query,
  // not a manual reconciliation against the org.
  salesforceCaseId   String?
  salesforceSyncedAt DateTime?
  salesforceError    String?

  // Document completeness verdict at submit time (spec: Completeness-Check).
  // Stored so the decision behind a 'fehlende Unterlagen' mail stays auditable.
  documentsComplete  Boolean?
  documentsMissing   String?

  // Nachreichung (spec V2): the one-time link sent in Mail 2b. The token is the only
  // credential the page asks for, so it is random, unique and expires.
  nachreichToken       String?   @unique
  nachreichExpiresAt   DateTime?
  nachreichCompletedAt DateTime?

  // SharePoint folder created by the original submission. Documents supplied later must
  // land beside the originals, and the folder name embeds the upload date — so the folder
  // has to be remembered rather than re-derived.
  sharepointFolderId String?

  // Relations
  client       Client?
  project      Project?
  documents Document[]
  property     Property?
  financing    Financing?
  borrowers    Borrower[]
}

model Client {
  id           String @id @default(uuid())
  inquiryId    String @unique
  firstName    String
  lastName     String
  email        String  // REQUIRED
  phone        String
  zip          String?
  ort          String?
  partnerEmail String?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id])
}

model Project {
  id              String @id @default(uuid())
  inquiryId       String @unique
  projektArt      String?
  kreditnehmerTyp String?
  liegenschaftZip String?
  // Salesforce/funnel fields
  borrowerType    String?
  artImmobilie    String?
  neubauArt       String?
  artLiegenschaft String?
  nutzung         String?
  renovation      String?
  renovationsBetrag String?
  reserviert      String?
  finanzierungsangebote String?
  angebote        Json?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id])
}
model Property {
  id                  String   @id @default(uuid())
  inquiryId           String   @unique
  // Property location, captured (and required) in PropertyStep. Feeds Case_Name__c and
  // the Salesforce Objektinformationen fields PLZ_Ort__c / City__c.
  zip                 String?
  ort                 String?
  artLiegenschaft     String?
  artImmobilie        String?
  nutzung             String?
  renovation          String?
  renovationsBetrag   String?
  finanzierungsangebote String?
  reserviert          String?
  angeboteListe       String[]
  angebote            Json?
  kreditnehmer        Json?
  firmen              Json?
  // Add other relations as needed
  inquiry             Inquiry @relation(fields: [inquiryId], references: [id])

  firmas              Firma[]
  kreditnehmers       Kreditnehmer[]
}
model Firma {
  id          String   @id @default(uuid())
  propertyId  String
  firmenname  String?

  property    Property @relation(fields: [propertyId], references: [id])
}


model Borrower {
  id         String @id @default(uuid())
  inquiryId  String
  firstName  String?
  lastName   String?
  birthdate  String?
  job        String?
  type       String?
  civil      String?
  firmaName  String?
  firmaUID   String?
  email      String?
  telefon    String?
  geburtsdatum String?
  erwerb     String?
  zivilstand String?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id])
}

model Financing {
  id                String   @id @default(uuid())
  inquiryId         String   @unique
  kaufpreis         String?
  eigenmittel_bar   String?
  eigenmittel_saeule3 String?
  eigenmittel_pk    String?
  eigenmittel_schenkung String?
  pkVorbezug        String?
  hypoBetrag        String?
  modell            String?
  einkommen         String?
  steueroptimierung String?
  kaufdatum         String?
  kommentar         String?
  abloesung_betrag  String?  // Make sure this line is included
  erhoehung         String?
  erhoehung_betrag  String?
  abloesedatum      String?
  brutto            String?

  inquiry           Inquiry @relation(fields: [inquiryId], references: [id])
}


model Kreditnehmer {
  id            String   @id @default(uuid())
  propertyId    String
  name          String?
  vorname       String?
  status        String?
  firmenname    String?
  geburtsdatum  String?
  property      Property @relation(fields: [propertyId], references: [id])
}
model Document {
  id          String   @id @default(uuid())
  inquiryId   String?
  email       String
  fileName    String
  fileUrl     String
  uploadedAt  DateTime @default(now())

  /// Which funnel document this file was supplied for (an i18n key from
  /// funnelDocumentCatalog, e.g. "funnel.salaryStatementBonus"). Null for a loose upload
  /// dropped in without picking a requirement. Ten Dok_*__c booleans cover forty documents,
  /// so Salesforce cannot answer this — it has to be recorded here.
  docType     String?

  /// The name the customer's file had before anything renamed it. Kept separate from
  /// fileName so an auto-generated name stays auditable back to the original upload.
  originalFileName String?

  /// What the AI made of this file (spec sections 27 and 36).
  ///
  /// `docType` above is the requirement the file answers; `aiDocType` is what the model
  /// thought it was. They are kept apart on purpose — the difference between them IS the
  /// wrong-document check, and collapsing them would erase the evidence for it.
  aiStatus     String?
  aiDocType    String?
  aiConfidence Float?
  /// The full analysis, so a value can always be traced back to what was read and how
  /// confident it was. Section 36 requires that to survive any later correction.
  aiAnalysis   Json?

  inquiry Inquiry? @relation(fields: [inquiryId], references: [id])
}

/// Where an upload waits until its Inquiry exists.
///
/// Files are pushed to SharePoint from the documents step, which runs BEFORE the funnel is
/// submitted — so at upload time there is no Inquiry row to point at. That is not an edge
/// case, it is every single upload: 2738 rows landed here against 27 that ever reached
/// Document, because nothing later went back to claim them.
///
/// `submissionId` is what makes claiming possible. The funnel mints it once per submission
/// and it becomes the Inquiry's own id, so /api/inquiry can adopt these rows the moment the
/// Inquiry is created.
model HoldingDocument {
  id         String   @id @default(uuid())
  email      String
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())
  // Optionally, add a session or tempUserId to associate with the user before inquiry is created
  tempUserId String?

  /// The funnel's submission id, which becomes the Inquiry id. Indexed because adoption
  /// queries by it on every submission.
  submissionId     String?
  /// Funnel document key this file was supplied for; carried over on adoption.
  docType          String?
  /// Name the file had when the customer picked it.
  originalFileName String?

  /// Analysis result, carried over to Document on adoption. A file is analysed at upload
  /// time, which is before the Inquiry exists — so it has to land here first.
  aiStatus     String?
  aiDocType    String?
  aiConfidence Float?
  aiAnalysis   Json?

  @@index([submissionId])
}
