model HoldingDocument {
  id         String   @id @default(uuid())
  email      String
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())
  // Optionally, add a session or tempUserId to associate with the user before inquiry is created
  tempUserId String?
}
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}
model Inquiry {
  id           String     @id @default(uuid())
  customerType String
  createdAt    DateTime   @default(now())

  // Salesforce sync outcome. The sync is non-fatal for the customer, so without this
  // an outage is invisible: "which leads never reached Salesforce" must be a query,
  // not a manual reconciliation against the org.
  salesforceCaseId   String?
  salesforceSyncedAt DateTime?
  salesforceError    String?

  // Document completeness verdict at submit time (spec: Completeness-Check).
  // Stored so the decision behind a 'fehlende Unterlagen' mail stays auditable.
  documentsComplete  Boolean?
  documentsMissing   String?

  // Nachreichung (spec V2): the one-time link sent in Mail 2b. The token is the only
  // credential the page asks for, so it is random, unique and expires.
  nachreichToken       String?   @unique
  nachreichExpiresAt   DateTime?
  nachreichCompletedAt DateTime?

  // SharePoint folder created by the original submission. Documents supplied later must
  // land beside the originals, and the folder name embeds the upload date — so the folder
  // has to be remembered rather than re-derived.
  sharepointFolderId String?

  // Relations
  client       Client?
  project      Project?
  documents Document[]
  property     Property?
  financing    Financing?
  borrowers    Borrower[]
}

model Client {
  id           String @id @default(uuid())
  inquiryId    String @unique
  firstName    String
  lastName     String
  email        String  // REQUIRED
  phone        String
  zip          String?
  ort          String?
  partnerEmail String?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id])
}

model Project {
  id              String @id @default(uuid())
  inquiryId       String @unique
  projektArt      String?
  kreditnehmerTyp String?
  liegenschaftZip String?
  // Salesforce/funnel fields
  borrowerType    String?
  artImmobilie    String?
  neubauArt       String?
  artLiegenschaft String?
  nutzung         String?
  renovation      String?
  renovationsBetrag String?
  reserviert      String?
  finanzierungsangebote String?
  angebote        Json?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id])
}
model Property {
  id                  String   @id @default(uuid())
  inquiryId           String   @unique
  // Property location, captured (and required) in PropertyStep. Feeds Case_Name__c and
  // the Salesforce Objektinformationen fields PLZ_Ort__c / City__c.
  zip                 String?
  ort                 String?
  artLiegenschaft     String?
  artImmobilie        String?
  nutzung             String?
  renovation          String?
  renovationsBetrag   String?
  finanzierungsangebote String?
  reserviert          String?
  angeboteListe       String[]
  angebote            Json?
  kreditnehmer        Json?
  firmen              Json?
  // Add other relations as needed
  inquiry             Inquiry @relation(fields: [inquiryId], references: [id])

  firmas              Firma[]
  kreditnehmers       Kreditnehmer[]
}
model Firma {
  id          String   @id @default(uuid())
  propertyId  String
  firmenname  String?

  property    Property @relation(fields: [propertyId], references: [id])
}


model Borrower {
  id         String @id @default(uuid())
  inquiryId  String
  firstName  String?
  lastName   String?
  birthdate  String?
  job        String?
  type       String?
  civil      String?
  firmaName  String?
  firmaUID   String?
  email      String?
  telefon    String?
  geburtsdatum String?
  erwerb     String?
  zivilstand String?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id])
}

model Financing {
  id                String   @id @default(uuid())
  inquiryId         String   @unique
  kaufpreis         String?
  eigenmittel_bar   String?
  eigenmittel_saeule3 String?
  eigenmittel_pk    String?
  eigenmittel_schenkung String?
  pkVorbezug        String?
  hypoBetrag        String?
  modell            String?
  einkommen         String?
  steueroptimierung String?
  kaufdatum         String?
  kommentar         String?
  abloesung_betrag  String?  // Make sure this line is included
  erhoehung         String?
  erhoehung_betrag  String?
  abloesedatum      String?
  brutto            String?

  inquiry           Inquiry @relation(fields: [inquiryId], references: [id])
}


model Kreditnehmer {
  id            String   @id @default(uuid())
  propertyId    String
  name          String?
  vorname       String?
  status        String?
  firmenname    String?
  geburtsdatum  String?
  property      Property @relation(fields: [propertyId], references: [id])
}
model Document {
  id          String   @id @default(uuid())
  inquiryId   String?
  email       String
  fileName    String
  fileUrl     String
  uploadedAt  DateTime @default(now())

  inquiry Inquiry? @relation(fields: [inquiryId], references: [id])
}

// ---------------------------------------------------------------------------
// Partnerportal. Partner and case data stay in Salesforce; these tables only hold
// who may log in, how, and what they did. Created by prisma/partner-portal.sql —
// never by `prisma migrate` (the migration history is stale).
// ---------------------------------------------------------------------------

model PortalUser {
  id              String    @id @default(uuid())
  // Always stored lowercased: it is the login.
  email           String    @unique
  role            String    @default("partner") // partner | admin
  status          String    @default("invited") // invited | active | disabled
  name            String?
  company         String?
  phone           String?
  // The Salesforce Contact the partner is, and the company Account it belongs to.
  // Cases are matched on the Contact (Case.Partner_Consultant__c).
  sfContactId     String?
  sfAccountId     String?
  // Sees all Cases of their company (Case.Account__c), not only their own. Defaults to the
  // Contact's Primary__c at invite; an admin can switch it.
  companyScope    Boolean   @default(false)
  passwordHash    String?
  termsAcceptedAt DateTime?
  invitedAt       DateTime?
  invitedBy       String?
  activatedAt     DateTime?
  lastLoginAt     DateTime?
  // Step 2 of the first login: the partner checked the data HYPOTEQ holds about them.
  profileConfirmedAt DateTime?
  // E-mail notification switches: { newCase, docs, status, lender } — all on when unset.
  notifyPrefs     Json?
  // de | en | fr | it — portal and e-mail language.
  locale          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tokens        PortalToken[]
  sessions      PortalSession[]
  notifications PortalNotification[]
}

// One-time links: invite (set up access), reset (new password), magic (log in).
// Only the SHA-256 of the token is stored, so a database leak does not leak links.
model PortalToken {
  id        String    @id @default(uuid())
  userId    String
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model PortalSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  // Admin "view as partner": the portal shows this Salesforce Contact's Cases, read-only.
  viewAsContactId String?
  viewAsName      String?

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Last state of a Case as the portal saw it. Comparing against it is how status changes
// become notifications — Salesforce itself does not tell us when a Case moves.
model PortalCaseState {
  caseId       String   @id
  contactId    String
  status       String
  missingCount Int      @default(0)
  // SharePoint folder for Cases that did not come through the funnel (no Inquiry folder).
  folderId     String?
  updatedAt    DateTime @updatedAt

  @@index([contactId])
}

// What each partner last saw of each Case. Per partner, because with company-wide
// visibility the consultant and the company's primary contact see the same Case.
model PortalCaseSeen {
  contactId    String
  caseId       String
  status       String
  missingCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@id([contactId, caseId])
  @@index([caseId])
}

model PortalNotification {
  id        String    @id @default(uuid())
  userId    String
  caseId    String
  caseNr    String
  kunde     String
  // new_case | docs | status | lender — which e-mail switch governs it
  kind      String
  // Text variant (keys of the `notif` dictionary) and the portal status it reports, so the
  // notification renders in whatever language the partner reads it in.
  variant   String
  status    String?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  emailedAt DateTime?

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([caseId])
}

// A message a partner sent to HYPOTEQ about a Case (also posted to Salesforce as a CaseComment).
model PortalMessage {
  id        String   @id @default(uuid())
  userId    String
  caseId    String
  body      String
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

// A file a partner uploaded to a Case through the portal.
model PortalUpload {
  id          String   @id @default(uuid())
  userId      String
  caseId      String
  docKey      String?
  docLabel    String
  fileName    String
  driveItemId String
  webUrl      String?
  createdAt   DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([userId, createdAt])
}

// Who did what, without sensitive content: action, actor, and a case or partner reference.
model PortalAuditLog {
  id         String   @id @default(uuid())
  at         DateTime @default(now())
  actorId    String?
  actorEmail String?
  action     String
  target     String?
  ip         String?

  @@index([at])
  @@index([actorEmail, action, at])
}
